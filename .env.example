# =============================================================================
# Tapioca Finance — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -- Database (Required) ------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/tapioca
DATABASE_ENCRYPTION_KEY=          # 64-char hex string for AES-256-GCM session encryption

# -- Privy Auth (Required) ----------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=         # Privy dashboard → App ID
PRIVY_APP_SECRET=                 # Privy dashboard → App Secret

# -- ZeroDev / Smart Accounts (Required) --------------------------------------
ZERODEV_PROJECT_ID=               # ZeroDev dashboard → Project ID
ZERODEV_BUNDLER_URL=              # e.g. https://rpc.zerodev.app/api/v3/<project_id>/chain/8453

# -- Base L2 RPC (Required) ---------------------------------------------------
NEXT_PUBLIC_BASE_RPC_URL=         # e.g. Alchemy/Infura Base RPC URL

# -- Redis (Required for production) ------------------------------------------
REDIS_URL=                        # e.g. redis://localhost:6379

# -- Cron / Agent (Required for production) -----------------------------------
CRON_SECRET=                      # Secret for authenticating cron job requests
RELAYER_PRIVATE_KEY=              # Private key for EIP-7702 undelegation relayer

# -- YO Protocol --------------------------------------------------------------
YO_PARTNER_ID=0                   # YO Protocol partner ID

# -- Coinbase (Optional — for transaction history) ----------------------------
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
NEXT_PUBLIC_COINBASE_APP_ID=

# -- Crossmint (Optional — for fiat on-ramp) ----------------------------------
CROSSMINT_SERVER_SIDE_API_KEY=
CROSSMINT_ENV=staging             # staging or production
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=

# -- Chain Config (Optional — defaults to Base mainnet) ------------------------
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_USDC_MINT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# -- Feature Flags -------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ERC4337_FALLBACK=true  # Enable ERC-4337 fallback for external wallets
AGENT_SIMULATION_MODE=false               # true = dry-run agent operations (no on-chain txs)

# -- Cron Tuning (Optional) ---------------------------------------------------
CRON_BATCH_SIZE=50
CRON_CONCURRENCY=10
